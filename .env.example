# =============================================================================
# Docker Compose – diese Werte werden von docker-compose.yml verwendet.
# Kopiere diese Datei nach .env und passe die Werte an.
# =============================================================================

POSTGRES_DB=contract_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Innerhalb von Docker Compose: Hostname = Service-Name "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/contract_review

# Redis – Platzhalter für spätere Arbeitspakete (Worker/Queue)
REDIS_URL=redis://redis:6379/0

# Port auf dem der App-Container nach außen erreichbar ist
APP_PORT=8000

# =============================================================================
# Lokale Entwicklung ohne Docker:
# Hostname auf localhost setzen, Datenbankname ggf. anpassen.
# =============================================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_review
